{
  "name": "@crewtrace/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "start": "node --import tsx src/local.ts",
    "dev": "node --watch --import tsx src/local.ts",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit",
    "migrate": "node --import tsx src/migrate.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@electric-sql/pglite": "^0.3.14",
    "alipay-sdk": "^4.14.0",
    "csv-parse": "^6.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
