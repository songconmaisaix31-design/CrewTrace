DATABASE_URL=pglite://.local/crewtrace
PUBLIC_BASE_URL=http://127.0.0.1:3000
ALLOWED_ORIGINS=http://127.0.0.1:5173
PORT=3000
PAYMENT_MODE=disabled
# 正式部署设置 PostgreSQL URL 和独立管理密钥，禁止复用旧版生产数据库。
# ADMIN_TOKEN=至少32字符
# PAYMENT_MODE=sandbox 或 production；缺少任意密钥立即拒绝启动。
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_KEY_TYPE=PKCS8
# ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# ALIPAY_SELLER_ID=
