DATABASE_URL=
ADMIN_TOKEN=
PUBLIC_BASE_URL=http://127.0.0.1:3000
# 可选 PUBLIC_MCP_URL 指定对外 MCP 地址，未设置时使用 PUBLIC_BASE_URL/mcp。
# 可选 PUBLIC_WEB_URL 指定同一环境的网页地址，用于 MCP 指引链接。
PUBLIC_WEB_URL=
EXPERIMENT_CHAIN_WRITES=OFF
# Comma-separated registered Agent IDs allowed to pull automatic CSV assignments.
EXPERIMENT_WORKER_AGENT_IDS=
PORT=3000
VALIDATOR_MODULE=workers
# 本轮本地实验自动签发配置；未启用时不产生任何履约凭证。
TRUST_ATTESTATION_ENABLED=false
TRUST_ISSUER_ID=ct-local-experiment
TRUST_KEY_ID=local-exp-1
# 独立实验环境签发私钥，禁止使用团队或生产私钥。
TRUST_ISSUER_PRIVATE_KEY=
TRUST_ORDER_SALT=
TRUST_BUYER_SALT=
TRUST_ENVIRONMENT=local
TRUST_DEPLOYMENT=crewtrace-local-experiment
# 签发密钥的稳定生效时间，早于该时间的凭证被视为无效。
TRUST_ISSUER_VALID_FROM=2026-01-01T00:00:00.000Z
TRUST_ATTESTATION_MAX_ATTEMPTS=3
# A_RANDOM | B_CAPABILITY | C_RUNTIME_REPUTATION | D_VERIFIED_REPUTATION
EXPERIMENT_MATCHING_POLICY=C_RUNTIME_REPUTATION
# off | shadow | enforce
EXPERIMENT_MATCHING_MODE=off
