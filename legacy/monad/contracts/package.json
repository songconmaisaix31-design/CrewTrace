{
  "name": "@co-vibe/ledger-contracts",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env HARDHAT_DISABLE_TELEMETRY=true hardhat build",
    "test": "cross-env HARDHAT_DISABLE_TELEMETRY=true hardhat test",
    "typecheck": "tsc --noEmit",
    "check:config": "node --import tsx scripts/check-config.ts",
    "deploy:testnet": "npm run build && node --import tsx scripts/deploy.ts",
    "deploy:collaboration": "npm run build && node --import tsx scripts/deploy-collaboration.ts",
    "verify:collaboration": "node --import tsx scripts/verify-collaboration.ts",
    "verify:testnet": "node --import tsx scripts/verify.ts",
    "smoke:testnet": "node --import tsx scripts/smoke.ts",
    "resume:smoke": "node --import tsx scripts/resume-smoke.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-node-test-runner": "^3.0.0",
    "@nomicfoundation/hardhat-viem": "^3.0.0",
    "@types/node": "^22.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.0.0",
    "hardhat": "3.20.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "viem": "^2.38.0"
  }
}
